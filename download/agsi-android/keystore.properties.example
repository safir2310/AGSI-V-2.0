# ==============================================================
# CONTOH konfigurasi signing release — salin jadi "keystore.properties"
# lalu isi nilai asli Anda. FILE keystore.properties SUDAH MASUK
# .gitIGNORE dan TIDAK BOLEH di-commit.
#
# Cara membuat keystore: lihat README bagian 5 (Pembuatan Keystore).
# ==============================================================

# Lokasi file keystore (relatif terhadap root proyek Android)
storeFile=agsi-release.keystore

# Password keystore & key — buat sendiri, simpan dengan aman!
storePassword=GANTI_PASSWORD_ANDA
keyAlias=agsi
keyPassword=GANTI_PASSWORD_ANDA
