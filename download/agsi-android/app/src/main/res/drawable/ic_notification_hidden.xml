<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3.6: ikon notifikasi LAYANAN transparan penuh.
     Notifikasi foreground service "AGSI aktif" wajib di-post (syarat
     Android), tapi kini TAK TERLIHAT: ikon alpha 0 + tanpa judul/teks.
     Sebagian ROM (MIUI/HyperOS, dsb.) memaksakan menampilkan notifikasi
     FGS walau channel IMPORTANCE_NONE — walau dipaksakan tampil,
     bentuknya 0 piksel sehingga status bar tetap bersih. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
