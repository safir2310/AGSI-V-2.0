<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- File sementara hasil jepretan kamera untuk input upload -->
    <cache-path
        name="camera"
        path="images/" />

    <!-- File sementara untuk lembar BAGIKAN (v1.3.27): PDF struk dll. -->
    <cache-path
        name="share"
        path="agsi-share/" />

    <!-- File sementara untuk dialog cetak PDF via printer sistem (v1.3.28) -->
    <cache-path
        name="print"
        path="print/" />

    <!-- File hasil simpan langsung Unduhan/AGSI di Android 8–9 — tap kartu
         notifikasi unduhan membuka file lewat FileProvider -->
    <external-path
        name="downloads"
        path="Download/AGSI/" />
</paths>
