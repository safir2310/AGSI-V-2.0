<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Kebijakan: HTTPS saja. Cleartext (http) dilarang di semua domain.
         Untuk pengembangan lokal (http://10.0.2.2:3000) tambahkan blok
         <domain-config cleartextTrafficPermitted="true"> sementara —
         lihat README bagian pengembangan. JANGAN dipakai di rilis. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
