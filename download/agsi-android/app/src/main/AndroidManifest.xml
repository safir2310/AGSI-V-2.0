<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pin GPS lokasi rumah pelanggan saat checkout antar (navigator.geolocation
         di WebView) — kurir antar diarahkan presisi ke titik rumah pelanggan -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Upload foto produk/banner via kamera (input file <capture>) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notifikasi pesanan (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⏰ Bangunkan layar & tampilkan aplikasi saat HP terkunci — notifikasi
         pesanan/chat penting lewat full-screen intent (APK sideload: izin
         diberikan otomatis, tidak lewat kebijakan Play Store) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Masuk biometrik: Face ID / sidik jari (layar buka kunci AppLock) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Berjalan di latar belakang: dialog sistem "abaikan
         optimasi baterai" diminta LANGSUNG saat aplikasi dibuka. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Hidupkan layanan pemantau sejak HP dinyalakan (BootReceiver).
         v1.3.33: izin FOREGROUND_SERVICE(_SPECIAL_USE) DIHAPUS lagi —
         layanan kembali service BIASA TANPA kartu notifikasi (permintaan
         pemilik: APK tanpa kredensial Firebase terlihat bersih). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Penyimpanan (v1.3.7): struk & laporan disimpan LANGSUNG ke folder
         Unduhan/AGSI di Android 8–9 (Android 10+ memakai MediaStore — tanpa
         izin). maxSdkVersion 32: Android 13+ memakai izin granular &
         Scoped Storage, izin legacy ini tidak berlaku. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- GPS tidak wajib — tanpa GPS app tetap terpasang, pin lokasi fallback alamat -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- v1.3.37 — visibilitas paket layanan cetak (Android 11+): deteksi
         dini Print Spooler yang dinonaktifkan ROM (OPPO/realme/MIUI) agar
         dialog cetak bisa diarahkan ke halaman "Aktifkan" aplikasinya -->
    <queries>
        <package android:name="com.android.printspooler" />
        <package android:name="com.android.print.spooler" />
    </queries>

    <application
        android:name=".AgsiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AGSI"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AGSI.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM: pesanan baru, status masakan, pembayaran, chat CS -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Pemantau notifikasi latar belakang: polling ringan API AGSI
             tiap ±45 detik selama aplikasi ditutup — pesanan baru, update
             status & chat muncul sebagai notifikasi layar. v1.3.33: service
             BIASA TANPA notifikasi (kartu "AGSI aktif" dihapus — permintaan
             pemilik); start dari aplikasi yang di depan + BootReceiver. -->
        <service
            android:name=".NotifPollerService"
            android:exported="false" />

        <!-- BOOT: HP dinyalakan ulang → layanan pemantau hidup lagi tanpa
             menunggu aplikasi dibuka (dalam jendela allowlist sementara
             BOOT_COMPLETED). BOOT_COMPLETED adalah protected broadcast —
             hanya sistem yang bisa mengirim. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- QUICK REPLY (v1.3.10): balas chat langsung dari notifikasi
             (RemoteInput → POST /api/chat dengan cookie sesi web). -->
        <receiver
            android:name=".ChatReplyReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="agsi_orders_v4" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
