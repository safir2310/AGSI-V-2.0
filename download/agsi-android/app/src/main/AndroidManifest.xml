<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pin GPS lokasi rumah pelanggan saat checkout antar (navigator.geolocation
         di WebView) — kurir antar diarahkan presisi ke titik rumah pelanggan -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Upload foto produk/banner via kamera (input file <capture>) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notifikasi pesanan (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⏰ Bangunkan layar & tampilkan aplikasi saat HP terkunci — notifikasi
         pesanan/chat penting lewat full-screen intent (APK sideload: izin
         diberikan otomatis, tidak lewat kebijakan Play Store) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Masuk biometrik: Face ID / sidik jari (layar buka kunci AppLock) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Berjalan di latar belakang (v1.3.9): dialog sistem "abaikan
         optimasi baterai" diminta LANGSUNG saat aplikasi dibuka. Layanan
         pemantau kini service BIASA tanpa notifikasi — izin
         FOREGROUND_SERVICE(_SPECIAL_USE) dihapus (v1.3.9). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Penyimpanan (v1.3.7): struk & laporan disimpan LANGSUNG ke folder
         Unduhan/AGSI di Android 8–9 (Android 10+ memakai MediaStore — tanpa
         izin). maxSdkVersion 32: Android 13+ memakai izin granular &
         Scoped Storage, izin legacy ini tidak berlaku. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- GPS tidak wajib — tanpa GPS app tetap terpasang, pin lokasi fallback alamat -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".AgsiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AGSI"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AGSI.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM: pesanan baru, status masakan, pembayaran, chat CS -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Pemantau notifikasi latar belakang (tanpa FCM): polling ringan
             API AGSI tiap ±45 detik selama aplikasi ditutup — pesanan baru,
             update status & chat muncul sebagai notifikasi layar. v1.3.9:
             service BIASA TANPA notifikasi latar belakang; start hanya dari
             aplikasi yang sedang di depan (FCM di atas = mekanisme utama). -->
        <service
            android:name=".NotifPollerService"
            android:exported="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="agsi_orders_v3" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
