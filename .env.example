# ============================================================
# AGSI POS — Contoh Environment Variables
# Salin nilai-nilai ini ke .env (lokal) dan ke Vercel:
#   Project ▸ Settings ▸ Environment Variables (Production)
# JANGAN isi nilai asli di berkas ini — berkas ini di-commit ke GitHub.
# ============================================================

# ===== DATABASE — WAJIB (tanpa ini login gagal "Terjadi kesalahan server.") =====
# Salin connection string dari Prisma Console (console.prisma.io ▸ project Anda ▸
# Connection string). Ketiga variabel diisi nilai yang sama.
DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"

# ===== EMAIL OTP LUPA PASSWORD (Resend) =====
# Panduan lengkap: EMAIL_SETUP.md
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Pengirim: onboarding@resend.dev hanya kirim ke email akun Resend sendiri.
# Untuk kirim ke semua pelanggan, verifikasi domain di Resend lalu ganti:
RESEND_FROM="AGSI POS <onboarding@resend.dev>"

# ===== FIREBASE PUSH NOTIFICATION (FCM HTTP v1) =====
# Sumber: Service account JSON (firebase-adminsdk-*.json) — panduan: PUSH_SETUP.md
FIREBASE_PROJECT_ID="agsi-pos-491c8"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@agsi-pos-491c8.iam.gserviceaccount.com"
# PENTING: pertahankan tanda kutip dan karakter \n persis seperti di file JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# --- Konfigurasi Web app "AGSI Web" (push Chrome/desktop) ---
# Sumber: Firebase Console ▸ Project settings ▸ General ▸ Your apps ▸ Web ▸ Config
FIREBASE_WEB_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_SENDER_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_APP_ID=""
# Opsional — hanya push web Chrome; ambil dari Firebase Console ▸ Project settings ▸
# Cloud Messaging ▸ Web Push certificates
FIREBASE_VAPID_KEY=""

# ===== QRIS / PEMBAYARAN (opsional — tanpa ini jalan di mode sandbox) =====
# Set QRIS_SANDBOX=false untuk produksi + isi kunci produksi.
# Panduan: MIDTRANS_SETUP.md
QRIS_SANDBOX="true"
QRIS_WEBHOOK_SECRET=""
QRIS_GATEWAY_URL=""
QRIS_GATEWAY_API_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY_PRODUCTION=""
MIDTRANS_CLIENT_KEY_PRODUCTION=""
CASAKU_LICENSE_KEY=""
CASAKU_WEBHOOK_SECRET=""
CASAKU_QR_ID=""
